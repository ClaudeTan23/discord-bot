# Copy this file to .env and fill in your values.
# .env is gitignored - never commit real credentials.

# Required: bot token from the Discord Developer Portal (Bot -> Reset Token).
Bot-Token = your-discord-bot-token-here

# Path to ffmpeg: the executable itself, or the folder containing it.
#   Windows:     C:\ffmpeg\bin\ffmpeg.exe
#   Linux/macOS: /usr/bin/ffmpeg
FFMPEG_PATH =

# Optional tuning.
# Seconds of audio buffered ahead of playback (default 10). Raise it if the
# audio still speeds up or stutters on a flaky connection; costs 192 KB per
# second per guild that is playing.
# MUSIC_AUDIO_BUFFER_SECONDS = 10

# Threads used for yt-dlp extraction (default 16). This work is CPU-heavy
# Python, so lowering it leaves more room for the audio thread on a small host.
# MUSIC_EXTRACTOR_WORKERS = 16

# --- Logging ----------------------------------------------------------------
# Logs are written to logs/YYYY/MM/DD/bot.log, with warnings and errors also
# copied into errors.log beside it. The bot token and signed stream URLs are
# redacted before anything is written, so a log file is safe to share.

# Where the log tree lives (default: <project>/logs).
# LOG_DIR =

# How much detail. DEBUG adds the queue and cache decisions that explain most
# "why did it skip that song" reports. One of DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL = INFO

# Day folders older than this are deleted at startup. 0 keeps everything.
# LOG_RETENTION_DAYS = 14

# Cap on one file before the day continues in bot.2.log (default 10 MB).
# LOG_MAX_BYTES = 10485760

# discord.py's own chatter. It logs every gateway heartbeat at INFO, which
# buries the bot's own records; its warnings always come through.
# LOG_DISCORD_LEVEL = WARNING