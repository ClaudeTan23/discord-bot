# Copy this file to .env and fill in your values.
# .env is gitignored - never commit real credentials.

# Required: bot token from the Discord Developer Portal (Bot -> Reset Token).
Bot-Token = your-discord-bot-token-here

# Path to ffmpeg: the executable itself, or the folder containing it.
#   Windows:     C:\ffmpeg\bin\ffmpeg.exe
#   Linux/macOS: /usr/bin/ffmpeg
FFMPEG_PATH =

# Optional tuning.
# Seconds of audio buffered ahead of playback (default 10). Raise it if the
# audio still speeds up or stutters on a flaky connection; costs 192 KB per
# second per guild that is playing.
# MUSIC_AUDIO_BUFFER_SECONDS = 10
# Threads used for yt-dlp extraction (default 16). This work is CPU-heavy
# Python, so lowering it leaves more room for the audio thread on a small host.
# MUSIC_EXTRACTOR_WORKERS = 16