/venv
/ffmpeg
__pycache__/
*.pyc
.claude

# Secrets - never commit
.env
*.env
!.env.example

# Runtime logs (logs/YYYY/MM/DD/). Credentials are redacted before they are
# written, but there is still no reason to commit them.
/logs

# Saved playlists (data/playlists.json). Users' own content, and
# rewritten on every change - not something to keep in git.
/data
